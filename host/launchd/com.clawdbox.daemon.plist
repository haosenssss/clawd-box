<?xml version="1.0" encoding="UTF-8"?>
<!--
  开机自启守护进程。

  KeepAlive 只在异常退出时重启（SuccessfulExit=false）——正常退出说明是
  你自己停的，不该被 launchd 立刻拉起来。

  这是**模板**：__BUN__ 和 __REPO__ 由 host/launchd/install.sh 在安装时替换成
  你机器上的真实路径。不要直接 cp 这个文件。

  安装：  ./host/launchd/install.sh
  卸载：  ./host/launchd/install.sh --uninstall
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clawdbox.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>run</string>
    <string>__REPO__/host/src/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__/host</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- 板子拔掉时守护进程会退避重连而不是退出，所以这里不该频繁触发；
       真触发了就说明是崩溃，10 秒足够避免疯狂重启刷日志。 -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/clawdbox-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/clawdbox-daemon.log</string>
</dict>
</plist>
